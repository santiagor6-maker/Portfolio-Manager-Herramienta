{
  "name": "portafolio-pro",
  "private": true,
  "version": "0.1.0",
  "description": "Seguimiento de portafolios multi-mercado y multi-divisa para inversionistas de mercados emergentes (Colombia, Brasil, Europa, EE.UU.)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "dev:web": "npm run dev -w @pm/web",
    "dev:server": "npm run dev -w @pm/server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
